{
   "manifest_version": 3,
   "name": "Area Fullscreen",
   "description": "브라우저 창이 놓인 영역만큼 동영상을 테두리 없는 전체화면으로 재생합니다.",
   "version": "1.0.0",
   "icons": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
   },
   "key": "",
   "permissions": [ "scripting", "storage", "nativeMessaging" ],
   "host_permissions": [ "<all_urls>" ],
   "background": {
      "service_worker": "worker.js"
   },
   "action": {
      "default_title": "영역 전체화면 켜기/끄기 (Alt+Shift+F)",
      "default_icon": {
         "16": "icons/16.png",
         "32": "icons/32.png"
      }
   },
   "commands": {
      "toggle": {
         "suggested_key": { "default": "Alt+Shift+F" },
         "description": "영역 전체화면 켜기/끄기"
      }
   }
}

{
   "manifest_version": 3,
   "name": "Full PIP",
   "description": "동영상만 테두리 없는 창으로 띄워, PIP처럼 크기 제한 없이 원하는 영역에 맞춰 봅니다.",
   "version": "1.0.0",
   "icons": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
   },
   "key": "",
   "permissions": [ "scripting", "storage", "nativeMessaging" ],
   "host_permissions": [ "<all_urls>" ],
   "background": {
      "service_worker": "worker.js"
   },
   "action": {
      "default_title": "Full PIP 켜기/끄기 (Alt+Shift+F)",
      "default_icon": {
         "16": "icons/16.png",
         "32": "icons/32.png"
      }
   },
   "commands": {
      "toggle": {
         "suggested_key": { "default": "Alt+Shift+F" },
         "description": "Full PIP 켜기/끄기"
      }
   }
}
